# AWS Configuration
# Use a named profile or rely on default credential chain (SSO, env vars, etc.)
AWS_REGION=us-east-1
AWS_PROFILE=your-profile-name

# Bedrock model (override if needed)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514

# DynamoDB (omit to use in-memory store)
# DYNAMODB_TABLE=a11y-agent-jobs
# DYNAMODB_ENDPOINT=http://localhost:8000

# API server
# PORT=3000
# HOST=0.0.0.0

# Auth (comma-separated API keys; omit to disable auth)
# API_KEYS=your-key-here,another-key

# Rate limiting (requests per minute per IP)
# RATE_LIMIT_MAX=100
